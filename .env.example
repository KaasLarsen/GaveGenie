# PostgreSQL connection string (required for import + gift finder)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gavegenie?schema=public"

# OpenAI API key (server-side only; required for Danish "hvorfor" explanations)
OPENAI_API_KEY="sk-..."

# Optional: override model (default: gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"

# Secret for POST /api/admin/import (Authorization: Bearer <ADMIN_SECRET>)
ADMIN_SECRET="change-me-to-a-long-random-string"

# Public site URL (used in sitemap / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Feed import (optional):
# IMPORT_SAMPLE=1          # import DEV sample instead of Partner Ads
# FEED_ID=2437             # import a single Partner Ads feed by feedid
# Partner Ads URLs live in src/lib/feeds/partner-ads-registry.ts (no secret required)
